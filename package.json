{
  "name": "effect-angular",
  "version": "0.0.2",
  "scripts": {
    "ng": "node ./node_modules/@angular/cli/bin/ng.js",
    "build": "node ./node_modules/@angular/cli/bin/ng.js build effect-platform-angular && node ./node_modules/@angular/cli/bin/ng.js build effect-angular-query",
    "watch:platform": "node ./node_modules/@angular/cli/bin/ng.js build effect-platform-angular --watch --configuration development",
    "watch:query": "node ./node_modules/@angular/cli/bin/ng.js build effect-angular-query --watch --configuration development",
    "test": "node ./node_modules/@angular/cli/bin/ng.js test --watch=false",
    "test:platform": "node ./node_modules/@angular/cli/bin/ng.js test effect-platform-angular --watch=false",
    "test:query": "node ./node_modules/@angular/cli/bin/ng.js test effect-angular-query --watch=false",
    "test:watch:platform": "node ./node_modules/@angular/cli/bin/ng.js test effect-platform-angular --watch=true",
    "test:watch:query": "node ./node_modules/@angular/cli/bin/ng.js test effect-angular-query --watch=true",
    "test:coverage": "node ./node_modules/@angular/cli/bin/ng.js test --configuration coverage --watch=false",
    "format": "prettier . --write --ignore-path .prettierignore",
    "format:check": "prettier . --check --ignore-path .prettierignore",
    "lint": "node --test scripts/npm-command.test.mjs && node scripts/verify-quality-config.mjs && eslint .",
    "effect:diagnostics": "effect-language-service diagnostics --project tsconfig.json --strict --format pretty",
    "pack:verify": "node scripts/verify-package-artifacts.mjs",
    "consumer:smoke": "node scripts/consumer-smoke-test.mjs",
    "pack:check": "bun run build && bun run pack:verify && bun run consumer:smoke",
    "audit:ci": "bun audit --audit-level=high"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "bun@1.3.14",
  "overrides": {
    "@hono/node-server": "1.19.13",
    "@isaacs/brace-expansion": "5.0.1",
    "fast-uri": "3.1.2",
    "hono": "4.12.29",
    "minimatch": "10.2.5",
    "path-to-regexp": "8.4.2",
    "picomatch": "4.0.5",
    "postcss": "8.5.16",
    "qs": "6.15.3",
    "sigstore": "4.1.1",
    "tar": "7.5.19",
    "undici": "7.28.0",
    "ws": "8.21.0"
  },
  "dependencies": {
    "@angular/common": "^22.0.7",
    "@angular/compiler": "^22.0.7",
    "@angular/core": "^22.0.7",
    "@angular/forms": "^22.0.7",
    "@angular/platform-browser": "^22.0.7",
    "@angular/router": "^22.0.7",
    "effect": "4.0.0-beta.97",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1"
  },
  "devDependencies": {
    "@angular/build": "^22.0.7",
    "@angular/cli": "^22.0.7",
    "@angular/compiler-cli": "^22.0.7",
    "@effect/language-service": "^0.87.0",
    "@eslint/js": "10.0.1",
    "@tanstack/angular-query-experimental": "^5.101.3",
    "@types/node": "^26.1.2",
    "@vitest/browser-playwright": "4.1.10",
    "@vitest/coverage-v8": "4.1.10",
    "angular-eslint": "22.1.0",
    "cross-spawn": "7.0.6",
    "eslint": "10.7.0",
    "jsdom": "^29.1.1",
    "ng-packagr": "^22.0.1",
    "prettier": "3.9.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
